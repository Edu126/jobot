# Rename to .env and fill in your Gemini API key.
# Get one for free at https://aistudio.google.com
GOOGLE_API_KEY=

# OPTIONAL — Prep company outlook (live intel). Free tier, no card:
# https://tavily.com  → sign up → copy key. Left blank, Prep still works
# with an honest fallback. When set, scripts/deploy-fly.sh stages it to each
# app automatically alongside GOOGLE_API_KEY.
TAVILY_API_KEY=
