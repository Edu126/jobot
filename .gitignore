# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ── Virtual environments ──
.venv/
venv/
env/
ENV/

# ── User data + secrets — never commit ──
data/
.env
.env.*
!.env.example

# ── Build / package output ──
dist/
build/
*.egg-info/
*.egg

# ── Legacy Streamlit UI archived — not shipped ──
_deprecated/

# ── OS junk ──
.DS_Store
Thumbs.db
*.swp
*~

# ── Editor / IDE ──
.vscode/
.idea/
*.iml

# ── Internal-only docs (Claude memory, changelog, screenshots) ──
PROJECT.md
.claude/
/tmp/
*.tmp

# ── Screenshots / dev artifacts ──
screenshots/
*.screenshot.png

# ── Pytest / coverage ──
.pytest_cache/
.coverage
htmlcov/

# ── Fly.io CLI cache ──
.fly/
